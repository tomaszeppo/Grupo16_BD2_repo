// Estilo de Neo4j Browser para el modelo de grafo del Fixture 2030.
// Importar desde :style > Upload en Neo4j Browser.

node.Equipo {
  color: #A78BFA;
  size: 78px;
  caption: "{codigo}";
}

node.Jugador {
  color: #34D399;
  size: 50px;
  caption: "{codigo}";
}

node.Partido {
  color: #0EA5E9;
  size: 100px;
  caption: "{codigo}";
}

node.Sede {
  color: #F97316;
  size: 80px;
  caption: "{nombre}";
}

node.Evento {
  color: #EF4444;
  size: 55px;
  caption: "{tipo} {minuto}'";
}
