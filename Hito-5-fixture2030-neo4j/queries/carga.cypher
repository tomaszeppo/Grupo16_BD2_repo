  {id: "J-QAT-1057", nombre: "Jugador", apellido: "Prueba QAT", dorsal: 99, equipo: "QAT", posicion: "Delantero"},
  {id: "J-UAE-1058", nombre: "Jugador", apellido: "Prueba UAE", dorsal: 99, equipo: "UAE", posicion: "Delantero"},
  {id: "J-IRQ-1059", nombre: "Jugador", apellido: "Prueba IRQ", dorsal: 99, equipo: "IRQ", posicion: "Delantero"},
  {id: "J-CHN-1060", nombre: "Jugador", apellido: "Prueba CHN", dorsal: 99, equipo: "CHN", posicion: "Delantero"},
  {id: "J-NZL-1061", nombre: "Jugador", apellido: "Prueba NZL", dorsal: 99, equipo: "NZL", posicion: "Delantero"},
  {id: "J-RSA-1062", nombre: "Jugador", apellido: "Prueba RSA", dorsal: 99, equipo: "RSA", posicion: "Delantero"},
  {id: "J-CIV-1063", nombre: "Jugador", apellido: "Prueba CIV", dorsal: 99, equipo: "CIV", posicion: "Delantero"},
  {id: "J-COD-1064", nombre: "Jugador", apellido: "Prueba COD", dorsal: 99, equipo: "COD", posicion: "Delantero"}
] AS row
MERGE (j:Jugador {id: row.id})
SET j.nombre = row.nombre,
    j.apellido = row.apellido,
    j.dorsal = row.dorsal,
    j.posicion = row.posicion
WITH j, row
MATCH (e:Equipo {codigo: row.equipo})
MERGE (j)-[:PERTENECE_A]->(e);

// Comprobación final: cantidades cargadas.
MATCH (e:Equipo)
WITH count(e) AS equipos
MATCH (j:Jugador)
RETURN equipos, count(j) AS jugadores;
