# Copiar a .env (no se versiona). Completar las contraseñas con valores locales.
TIMEOUT_SEGUNDOS=3.0
# Tope duro por request: pasado este tiempo la API responde 504 sin esperar al driver
DEADLINE_SEGUNDOS=10.0

MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_USER=admin
MONGO_PASSWORD=
MONGO_DB=fixture2030

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DB=neo4j

CASSANDRA_HOST=localhost
CASSANDRA_PORT=9042
CASSANDRA_KEYSPACE=fixture2030

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

INFLUX_URL=http://localhost:8181
INFLUX_DB=fixture2030_metrics
# Lo completa scripts/levantar_servicios.sh la primera vez
INFLUX_TOKEN=

IRIS_HOST=localhost
IRIS_PORT=1972
IRIS_NAMESPACE=USER
IRIS_USER=fixture
IRIS_PASSWORD=

# Opcional: puertos publicados en el notebook (por defecto los estándar). Cambiarlos si ya hay otra base en ese puerto
# (y poner el mismo valor en MONGO_PORT / REDIS_PORT / CASSANDRA_PORT / etc. para la API que corre en el notebook).
# MONGO_HOST_PORT=27017
# NEO4J_HOST_PORT=7687
# CASSANDRA_HOST_PORT=9042
# REDIS_HOST_PORT=6379
# INFLUX_HOST_PORT=8181
# IRIS_HOST_PORT=1972
