; Carga y compila las clases del Hito 9 montadas en /clases (sin la demo).
Set err = ""
For clase = "Persona","Jugador","Arbitro","Tecnico","Partido","Evento" {
    Set sc = $System.OBJ.Load("/clases/Fixture."_clase_".cls","k",.err)
    Write "Load Fixture."_clase_" error? ",$System.Status.IsError(sc),!
}
Set sc = $System.OBJ.Compile("Fixture.*","ck",.err)
If $System.Status.IsError(sc) { Write "COMPILACION CON ERRORES:",! Do $System.Status.DisplayError(sc) }
If '$System.Status.IsError(sc) { Write "COMPILACION OK: Fixture.*",! }
Halt
