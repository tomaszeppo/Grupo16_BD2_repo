# Ejemplo sin secretos. La configuración activa se mantiene en el .env raíz del Hito 10.
TIMEOUT_SEGUNDOS=3.0
DEADLINE_SEGUNDOS=10.0

# Con API ejecutándose en la notebook: host local y puerto publicado.
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_USER=admin
MONGO_PASSWORD=
MONGO_DB=fixture2030

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DB=neo4j

CASSANDRA_HOST=localhost
CASSANDRA_PORT=9042
CASSANDRA_KEYSPACE=fixture2030

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

INFLUX_URL=http://localhost:8181
INFLUX_DB=fixture2030_metrics
INFLUX_TOKEN=

IRIS_HOST=localhost
IRIS_PORT=1972
IRIS_NAMESPACE=USER
IRIS_USER=fixture
IRIS_PASSWORD=

