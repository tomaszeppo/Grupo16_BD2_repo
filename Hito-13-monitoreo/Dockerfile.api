# Misma base que la API del Hito 10 más prometheus_client. El código se monta en solo lectura desde el compose.
FROM python:3.12-slim
WORKDIR /srv
COPY --from=h10 requirements.txt requirements-drivers.txt ./
COPY api_instrumentada/requirements.txt ./requirements-metricas.txt
RUN pip install --no-cache-dir -r requirements.txt -r requirements-drivers.txt -r requirements-metricas.txt
ENV PYTHONUNBUFFERED=1 PYTHONPATH=/srv/h10:/srv/h13
WORKDIR /srv/h10
EXPOSE 8001
CMD ["uvicorn", "api_instrumentada.main:create_app", "--factory", "--host", "0.0.0.0", "--port", "8001"]
