    {
      "id": 2,
      "type": "timeseries",
      "title": "Pedidos por segundo, por endpoint",
      "description": "rate(...[1m]) del contador de pedidos: promedio por segundo del último minuto.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-fixture"
      },
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-fixture"
          },
          "expr": "sum by (endpoint, metodo) (rate(fixture2030_http_requests_total[1m]))",
          "legendFormat": "{{metodo}} {{endpoint}}",
          "refId": "A",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Respuestas no exitosas por código (por segundo)",
