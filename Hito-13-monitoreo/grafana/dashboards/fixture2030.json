{
  "uid": "fixture2030",
  "title": "Fixture 2030 — Plataforma",
  "tags": [
    "fixture2030",
    "hito13"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "refresh": "5s",
  "description": "Estado, tráfico, errores y tiempos de la API del Fixture 2030 y de sus bases. Recolección cada 5 s.",
  "panels": [
    {
      "type": "row",
      "title": "Estado de los componentes",
      "id": 100,
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 1,
      "type": "stat",
      "title": "Bases: ¿responden a la API?",
      "description": "fixture2030_dependencia_disponible: ping de cada base en cada recolección (cada 5 s), el mismo chequeo de GET /health. Medido desde la API.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-fixture"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 16,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-fixture"
          },
          "expr": "fixture2030_dependencia_disponible",
          "legendFormat": "{{fuente}}",
          "refId": "A",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "Responde",
                  "color": "green"
                },
                "0": {
                  "text": "Caída",
                  "color": "red"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "unit": "none"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 12,
