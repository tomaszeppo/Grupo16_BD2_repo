# Copiar a .env (no se versiona) y completar las claves con valores propios.
MONGO_USER=admin
MONGO_PASSWORD=
# Neo4j exige al menos 8 caracteres
NEO4J_PASSWORD=
# Clave que piden los pedidos de administración (encabezado X-Admin-Clave)
ADMIN_CLAVE=
# Contraseña de Redis (sesiones, partido en vivo)
REDIS_PASSWORD=
# Contraseña del usuario admin de Grafana (http://127.0.0.1:3001)
GRAFANA_PASSWORD=

# Cantidad de procesos de la API
API_PROCESOS=2
# Segundos que la API conserva su copia del calendario. 0 = consultar Neo4j en cada pronóstico (solo para comparar).
CALENDARIO_TTL_SEGUNDOS=30

# Límites de cada contenedor. Las mediciones guardan estos valores junto al resultado.
# API_MEMORIA=512m
# API_CPUS=1.0
# MONGO_MEMORIA=512m
# MONGO_CPUS=1.0
# NEO4J_MEMORIA=1g
# NEO4J_CPUS=1.0

# Puertos publicados en el equipo (cambiarlos si están ocupados)
# API_PUERTO=8010
# MONGO1_PUERTO=27217
# MONGO2_PUERTO=27218
# MONGO3_PUERTO=27219
# NEO4J_HTTP_PUERTO=7475
# NEO4J_BOLT_PUERTO=7688
# REDIS_PUERTO=6380
# REDIS_REPLICA_PUERTO=6381
# PROMETHEUS_PUERTO=9091
# GRAFANA_PUERTO=3001
# CASSANDRA_AMERICA_PUERTO=9043
# CASSANDRA_EUROPA_PUERTO=9044

# InfluxDB del TPO: CPU y memoria del contenedor de laboratorio
# INFLUX_CPUS=0.5
# INFLUX_MEMORIA=1g

# Redis: CPU y memoria
# REDIS_CPUS=0.5
# REDIS_MEMORIA=256m

# Cassandra: dos nodos (uno por región). Con 384M de heap cada uno usa unos 750 MB.
# CASSANDRA_HEAP=384M
# CASSANDRA_MEMORIA=900m
# CASSANDRA_CPUS=0.75
