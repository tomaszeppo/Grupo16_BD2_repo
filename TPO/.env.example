# Copiar a .env (no se versiona) y completar las tres claves con valores propios.
MONGO_USER=admin
MONGO_PASSWORD=
# Neo4j exige al menos 8 caracteres
NEO4J_PASSWORD=
# Clave que piden los pedidos de administración (encabezado X-Admin-Clave)
ADMIN_CLAVE=

# Cantidad de procesos de la API
API_PROCESOS=2
# Segundos que la API conserva su copia del calendario. 0 = consultar Neo4j en cada pronóstico (solo para comparar).
CALENDARIO_TTL_SEGUNDOS=30

# Límites de cada contenedor. Las mediciones guardan estos valores junto al resultado.
# API_MEMORIA=512m
# API_CPUS=1.0
# MONGO_MEMORIA=512m
# MONGO_CPUS=1.0
# NEO4J_MEMORIA=1g
# NEO4J_CPUS=1.0

# Puertos publicados en el equipo (cambiarlos si están ocupados)
# API_PUERTO=8010
# MONGO1_PUERTO=27217
# MONGO2_PUERTO=27218
# MONGO3_PUERTO=27219
# NEO4J_HTTP_PUERTO=7475
# NEO4J_BOLT_PUERTO=7688
