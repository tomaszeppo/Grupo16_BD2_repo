    {
      "id": 14,
      "type": "timeseries",
      "title": "Audiencia por minuto, partido y país (InfluxDB)",
      "description": "Espectadores contados en cada minuto simulado, apilados por país (medida audiencia_partido). La altura total es la audiencia del partido.",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-tpo"
      },
      "gridPos": {
        "x": 0,
        "y": 35,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-tpo"
          },
          "rawSql": "SELECT time, CAST(concat(partido_id, ' ', pais) AS VARCHAR) AS serie, espectadores FROM audiencia_partido WHERE $__timeFilter(time) AND espectadores > 0 ORDER BY time",
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "fillOpacity": 35,
            "lineWidth": 1,
            "spanNulls": false,
            "insertNulls": 5000
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
