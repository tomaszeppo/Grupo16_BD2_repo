{
  "uid": "prode2030",
  "title": "Prode Mundial 2030",
  "tags": [
    "prode2030"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "API",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Mirando partidos en vivo",
      "description": "Conexiones en vivo abiertas, suma de los procesos de la API (prode_vivo_conexiones).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-tpo"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 4,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-tpo"
          },
          "expr": "sum(prode_vivo_conexiones)",
          "legendFormat": "conexiones",
          "refId": "A",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        },
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Pedidos por segundo, por ruta",
      "description": "prode_api_pedidos_total. La conexión en vivo cuenta una vez, al cerrarse.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-tpo"
      },
      "gridPos": {
        "x": 4,
        "y": 1,
        "w": 10,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-tpo"
          },
          "expr": "sum by (ruta) (rate(prode_api_pedidos_total[1m]))",
          "legendFormat": "{{ruta}}",
          "refId": "A",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Respuestas con error, por ruta y estado",
      "description": "5xx: falla nuestra o de una base. 429: modo lento del chat.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-tpo"
      },
      "gridPos": {
        "x": 14,
        "y": 1,
        "w": 10,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-tpo"
          },
          "expr": "sum by (ruta, estado) (rate(prode_api_pedidos_total{estado=~\"5..|429\"}[1m]))",
          "legendFormat": "{{estado}} {{ruta}}",
          "refId": "A",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Latencia p95 por ruta",
      "description": "prode_api_duracion_segundos. Sin la conexión en vivo, que dura todo el partido.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-tpo"
      },
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-tpo"
          },
          "expr": "histogram_quantile(0.95, sum by (le, ruta) (rate(prode_api_duracion_segundos_bucket{ruta!=\"/partidos/{partido_id}/vivo\"}[1m])))",
          "legendFormat": "{{ruta}}",
          "refId": "A",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
