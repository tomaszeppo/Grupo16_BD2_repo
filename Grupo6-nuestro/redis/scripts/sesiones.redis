# sesiones.redis
# Ciclo de vida completo de una sesion: crear, validar/renovar, y cerrar.
# Se puede correr varias veces: empieza borrando las claves de la demo.

DEL sesion:sess-demo-001
DEL usuario:user-00001:sesion_activa

# --- Crear sesion (los datos y el TTL de la sesion y del puntero, juntos) ---
MULTI
HSET sesion:sess-demo-001 usuario_id user-00001 creado_en 2030-07-20T21:00:00 ultima_actividad 2030-07-20T21:00:00 estado activa
EXPIRE sesion:sess-demo-001 1800
SET usuario:user-00001:sesion_activa sess-demo-001 EX 1800
EXEC

# --- Verificar que existe y ver su TTL ---
EXISTS sesion:sess-demo-001
TTL sesion:sess-demo-001
HGETALL sesion:sess-demo-001

# --- Validar / renovar (se corre en cada accion del usuario logueado) ---
# HSET por si solo NO renueva el TTL de la clave: modificar un campo del hash
# deja el vencimiento donde estaba. La renovacion es explicita (EXPIRE) y va
# junto con el HSET dentro de MULTI/EXEC, para que no quede una ventana en la
# que se actualizo la actividad pero la sesion (o el puntero) vence igual.
MULTI
HSET sesion:sess-demo-001 ultima_actividad 2030-07-20T21:12:00
EXPIRE sesion:sess-demo-001 1800
EXPIRE usuario:user-00001:sesion_activa 1800
EXEC
TTL sesion:sess-demo-001
TTL usuario:user-00001:sesion_activa

# --- Buscar la sesion activa de un usuario a partir de su id ---
GET usuario:user-00001:sesion_activa

# --- Sesion inexistente (comportamiento esperado: se trata como anonimo) ---
EXISTS sesion:sess-que-no-existe
HGETALL sesion:sess-que-no-existe

# --- Cerrar sesion explicitamente (no se espera al TTL) ---
DEL sesion:sess-demo-001 usuario:user-00001:sesion_activa
EXISTS sesion:sess-demo-001
