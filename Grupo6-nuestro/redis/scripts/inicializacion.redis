# inicializacion.redis
# Verificaciones de arranque y configuracion. No hay "esquema" que crear en
# Redis -- este archivo deja registrado el estado esperado del servidor
# antes de cargar nada.

# Confirmar que el servidor responde
PING

# Version real del servidor, para registrar en docs/evidencia (RNF10, la
# consigna pide anotar la version porque se usa la etiqueta latest)
INFO server

# Confirmar la politica de memoria configurada en docker-compose.yml
CONFIG GET maxmemory
CONFIG GET maxmemory-policy

# Confirmar que la persistencia (appendonly) esta activa
CONFIG GET appendonly

# La base arranca vacia
DBSIZE
