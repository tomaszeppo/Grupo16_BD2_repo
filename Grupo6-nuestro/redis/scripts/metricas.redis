# metricas.redis
# Inspeccion y metricas del modulo. Nunca se usa KEYS (bloqueante sobre
# todo el espacio de claves) -- siempre SCAN con MATCH, segun RNF8.

# --- Memoria en uso, para contrastar contra el maxmemory de 256mb ---
INFO memory

# --- Cantidad total de claves (operacion liviana, a diferencia de KEYS) ---
DBSIZE

# --- Cuantas sesiones activas hay ahora mismo, sin bloquear el servidor ---
# (SCAN devuelve un cursor; en un script real se itera hasta que el
# cursor vuelve a 0. Esta es una sola pasada de ejemplo.)
SCAN 0 MATCH sesion:* COUNT 100

# --- Cuantas claves de cache hay ---
SCAN 0 MATCH cache:* COUNT 100

# --- Top 10 del ranking publico, para un panel de resumen ---
ZREVRANGE ranking:publico 0 9 WITHSCORES

# --- Posicion y puntaje de un usuario puntual en el ranking ---
# ZREVRANK da la posicion (0 = primero); ZSCORE da el score combinado.
ZREVRANK ranking:publico user-00001
ZSCORE ranking:publico user-00001

# --- Cuantos usuarios tiene el ranking en total ---
ZCARD ranking:publico

# --- Politica de memoria vigente (para confirmar que no se desconfiguro) ---
CONFIG GET maxmemory-policy
