# carga_muestra.redis
# Datos de ejemplo para desarrollo: sesiones, cache de equipos, y el
# ranking publico con el caso de empate ya armado (ver
# docs/ciclo_de_vida_e_invalidacion.md para la explicacion completa).

# --- Limpieza previa: borra las claves de muestra (lista finita, nunca KEYS) ---
# HINCRBY, INCR y EVAL suman sobre lo que ya hay; sin esto, correr la carga dos
# veces duplicaria puntos, antelacion y likes. Con el DEL inicial el resultado es
# el mismo en la primera y en la N-esima corrida.
DEL sesion:sess-000001
DEL usuario:user-00001:sesion_activa
DEL sesion:sess-000002
DEL usuario:user-00002:sesion_activa
DEL sesion:sess-000003
DEL usuario:user-00003:sesion_activa
DEL sesion:sess-000004
DEL usuario:user-00004:sesion_activa
DEL sesion:sess-000005
DEL usuario:user-00005:sesion_activa
DEL sesion:sess-000006
DEL usuario:user-00006:sesion_activa
DEL sesion:sess-000007
DEL usuario:user-00007:sesion_activa
DEL sesion:sess-000008
DEL usuario:user-00008:sesion_activa
DEL sesion:sess-000009
DEL usuario:user-00009:sesion_activa
DEL sesion:sess-000010
DEL usuario:user-00010:sesion_activa
DEL cache:equipo:ARG
DEL cache:equipo:BRA
DEL cache:equipo:ESP
DEL cache:equipo:FRA
DEL cache:equipo:GER
DEL cache:equipo:JPN
DEL ranking:publico:usuario:user-00001
DEL ranking:publico
DEL ranking:publico:usuario:user-00002
DEL ranking:publico:usuario:user-00003
DEL ranking:publico:usuario:user-00004
DEL ranking:publico:usuario:user-00005
DEL ranking:publico:usuario:user-00006
DEL ranking:publico:usuario:user-00007
DEL ranking:publico:usuario:user-00008
DEL ranking:publico:usuario:user-00009
DEL ranking:publico:usuario:user-00010
DEL ranking:publico:usuario:user-00011
DEL ranking:publico:usuario:user-00012
DEL ranking:publico:usuario:user-00013
DEL ranking:publico:usuario:user-00014
DEL ranking:publico:usuario:user-00015
DEL marcador:P-01
DEL marcador:P-02
DEL likes:comentario:P-01-EV1
DEL likes:pendientes_sync
DEL espectadores:P-01

# --- Sesiones de muestra (10 usuarios con sesion activa) ---
HSET sesion:sess-000001 usuario_id user-00001 creado_en 2030-07-20T20:01:00 ultima_actividad 2030-07-20T20:01:00 estado activa
EXPIRE sesion:sess-000001 1800
SET usuario:user-00001:sesion_activa sess-000001 EX 1800
HSET sesion:sess-000002 usuario_id user-00002 creado_en 2030-07-20T20:02:00 ultima_actividad 2030-07-20T20:02:00 estado activa
EXPIRE sesion:sess-000002 1800
SET usuario:user-00002:sesion_activa sess-000002 EX 1800
HSET sesion:sess-000003 usuario_id user-00003 creado_en 2030-07-20T20:03:00 ultima_actividad 2030-07-20T20:03:00 estado activa
EXPIRE sesion:sess-000003 1800
SET usuario:user-00003:sesion_activa sess-000003 EX 1800
HSET sesion:sess-000004 usuario_id user-00004 creado_en 2030-07-20T20:04:00 ultima_actividad 2030-07-20T20:04:00 estado activa
EXPIRE sesion:sess-000004 1800
SET usuario:user-00004:sesion_activa sess-000004 EX 1800
HSET sesion:sess-000005 usuario_id user-00005 creado_en 2030-07-20T20:05:00 ultima_actividad 2030-07-20T20:05:00 estado activa
EXPIRE sesion:sess-000005 1800
SET usuario:user-00005:sesion_activa sess-000005 EX 1800
HSET sesion:sess-000006 usuario_id user-00006 creado_en 2030-07-20T20:06:00 ultima_actividad 2030-07-20T20:06:00 estado activa
EXPIRE sesion:sess-000006 1800
SET usuario:user-00006:sesion_activa sess-000006 EX 1800
HSET sesion:sess-000007 usuario_id user-00007 creado_en 2030-07-20T20:07:00 ultima_actividad 2030-07-20T20:07:00 estado activa
EXPIRE sesion:sess-000007 1800
SET usuario:user-00007:sesion_activa sess-000007 EX 1800
HSET sesion:sess-000008 usuario_id user-00008 creado_en 2030-07-20T20:08:00 ultima_actividad 2030-07-20T20:08:00 estado activa
EXPIRE sesion:sess-000008 1800
SET usuario:user-00008:sesion_activa sess-000008 EX 1800
HSET sesion:sess-000009 usuario_id user-00009 creado_en 2030-07-20T20:09:00 ultima_actividad 2030-07-20T20:09:00 estado activa
EXPIRE sesion:sess-000009 1800
SET usuario:user-00009:sesion_activa sess-000009 EX 1800
HSET sesion:sess-000010 usuario_id user-00010 creado_en 2030-07-20T20:10:00 ultima_actividad 2030-07-20T20:10:00 estado activa
EXPIRE sesion:sess-000010 1800
SET usuario:user-00010:sesion_activa sess-000010 EX 1800

# --- Cache de catalogo (equipos mas consultados) ---
SET cache:equipo:ARG "{\"codigo\":\"ARG\",\"confederacion\":\"CONMEBOL\",\"ranking\":1}" EX 300
SET cache:equipo:BRA "{\"codigo\":\"BRA\",\"confederacion\":\"CONMEBOL\",\"ranking\":4}" EX 300
SET cache:equipo:ESP "{\"codigo\":\"ESP\",\"confederacion\":\"UEFA\",\"ranking\":9}" EX 300
SET cache:equipo:FRA "{\"codigo\":\"FRA\",\"confederacion\":\"UEFA\",\"ranking\":12}" EX 300
SET cache:equipo:GER "{\"codigo\":\"GER\",\"confederacion\":\"UEFA\",\"ranking\":13}" EX 300
SET cache:equipo:JPN "{\"codigo\":\"JPN\",\"confederacion\":\"AFC\",\"ranking\":33}" EX 300

# --- Ranking publico: caso de empate (el mismo que se valido antes de
#     escribir el script) mas otros usuarios para que la tabla no sea trivial ---
# El orden esperado despues de cargar todo esto, de 1ro a ultimo:
#   1) user-00003 (300 puntos, 8800 de antelacion)
#   2) user-00001 (300 puntos, 5000 de antelacion)
#   3) user-00002 (300 puntos, 1200 de antelacion)
#   4) user-00006 (280 puntos)
#   5) user-00004 (250 puntos, pese a tener la mayor antelacion de todos)
#   6) user-00005 (210 puntos)
#   ... y el resto, mas abajo, puntaje descendente
EVAL "local hash_key = KEYS[1]; local zset_key = KEYS[2]; local usuario_id = ARGV[1]; local delta_puntos = tonumber(ARGV[2]); local delta_antelacion = tonumber(ARGV[3]); local antelacion_max = tonumber(ARGV[4]); local puntos = redis.call('HINCRBY', hash_key, 'puntos', delta_puntos); local antelacion = redis.call('HINCRBYFLOAT', hash_key, 'antelacion_total', delta_antelacion); redis.call('HSET', hash_key, 'actualizado_en', ARGV[5]); local score = tonumber(puntos) + (tonumber(antelacion) / antelacion_max); redis.call('ZADD', zset_key, score, usuario_id); return {puntos, antelacion, tostring(score)}" 2 ranking:publico:usuario:user-00001 ranking:publico user-00001 300 5000 10000000 2030-07-20T22:00:00
EVAL "local hash_key = KEYS[1]; local zset_key = KEYS[2]; local usuario_id = ARGV[1]; local delta_puntos = tonumber(ARGV[2]); local delta_antelacion = tonumber(ARGV[3]); local antelacion_max = tonumber(ARGV[4]); local puntos = redis.call('HINCRBY', hash_key, 'puntos', delta_puntos); local antelacion = redis.call('HINCRBYFLOAT', hash_key, 'antelacion_total', delta_antelacion); redis.call('HSET', hash_key, 'actualizado_en', ARGV[5]); local score = tonumber(puntos) + (tonumber(antelacion) / antelacion_max); redis.call('ZADD', zset_key, score, usuario_id); return {puntos, antelacion, tostring(score)}" 2 ranking:publico:usuario:user-00002 ranking:publico user-00002 300 1200 10000000 2030-07-20T22:00:01
EVAL "local hash_key = KEYS[1]; local zset_key = KEYS[2]; local usuario_id = ARGV[1]; local delta_puntos = tonumber(ARGV[2]); local delta_antelacion = tonumber(ARGV[3]); local antelacion_max = tonumber(ARGV[4]); local puntos = redis.call('HINCRBY', hash_key, 'puntos', delta_puntos); local antelacion = redis.call('HINCRBYFLOAT', hash_key, 'antelacion_total', delta_antelacion); redis.call('HSET', hash_key, 'actualizado_en', ARGV[5]); local score = tonumber(puntos) + (tonumber(antelacion) / antelacion_max); redis.call('ZADD', zset_key, score, usuario_id); return {puntos, antelacion, tostring(score)}" 2 ranking:publico:usuario:user-00003 ranking:publico user-00003 300 8800 10000000 2030-07-20T22:00:02
