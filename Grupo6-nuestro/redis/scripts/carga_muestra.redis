# Verificar el resultado:
ZREVRANGE ranking:publico 0 -1 WITHSCORES

# --- Marcador en vivo (reemplaza/complementa la caché de equipo) ---
HSET marcador:P-01 goles_local 1 goles_visitante 0 minuto 23 ultimo_evento "Gol de ARG-20" actualizado_en 2030-06-08T18:23:00
HSET marcador:P-02 goles_local 0 goles_visitante 0 minuto 10 ultimo_evento "Arranca el partido" actualizado_en 2030-06-09T18:10:00

# --- Likes de comentarios ---
INCR likes:comentario:P-01-EV1
INCR likes:comentario:P-01-EV1
INCR likes:comentario:P-01-EV1
SADD likes:pendientes_sync P-01-EV1

# --- Espectadores en vivo de P-01 (timestamps de ejemplo) ---
ZADD espectadores:P-01 1907172000 sess-000001
ZADD espectadores:P-01 1907172005 sess-000002
ZADD espectadores:P-01 1907172010 sess-000003
