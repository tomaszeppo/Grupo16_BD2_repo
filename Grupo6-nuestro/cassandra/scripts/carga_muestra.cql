-- carga_muestra.cql
-- Carga chica para desarrollo: 5 partidos de referencia (P-01 a P-05, las
-- mismas fechas que el modulo de grafos del Hito 5) y 40 comentarios de
-- ejemplo repartidos en 2 buckets por partido. Para el volumen real (>1M)
-- ver scripts/generar_carga_masiva.py.

USE fixture2030;

-- Partidos de referencia
INSERT INTO partidos_referencia (partido_codigo, fecha_inicio) VALUES ('P-01', '2030-06-08T18:00:00');
