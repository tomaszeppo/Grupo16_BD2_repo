# cache.redis
# Patron cache-aside completo: miss, hit, e invalidacion por cambio en la
# fuente de verdad (Mongo, Hito 4).

# --- Cache miss (la clave todavia no existe) ---
GET cache:equipo:ARG

# --- La aplicacion resolvio el miss consultando Mongo, y guarda la copia ---
SET cache:equipo:ARG "{\"codigo\":\"ARG\",\"confederacion\":\"CONMEBOL\",\"ranking\":1}" EX 300

# --- Proximas lecturas: cache hit, no se toca Mongo ---
GET cache:equipo:ARG
TTL cache:equipo:ARG

# --- Cambio en la fuente de verdad (por ejemplo, UPDATE de ranking en Mongo) ---
# La aplicacion invalida la copia en el mismo momento del cambio, no espera al TTL.
DEL cache:equipo:ARG
GET cache:equipo:ARG

# --- Otro equipo, para ver varias claves del mismo dominio ---
SET cache:equipo:BRA "{\"codigo\":\"BRA\",\"confederacion\":\"CONMEBOL\",\"ranking\":4}" EX 300
GET cache:equipo:BRA

# --- Resumen de un partido finalizado (cache-aside sobre una copia derivada) ---
# Copia reconstruible de lo que responde la fuente de verdad (Mongo). La
# revision_fuente permite ver, tras invalidar, que la copia nueva viene de la
# version actual. TTL corto (30 s): tope de permanencia si no hay antes una
# invalidacion de negocio.
DEL cache:partido:P-01:resumen
GET cache:partido:P-01:resumen
SET cache:partido:P-01:resumen "{\"partido\":\"P-01\",\"local\":\"ARG\",\"visitante\":\"BRA\",\"estado\":\"FINALIZADO\",\"goles_local\":1,\"goles_visitante\":0,\"revision_fuente\":1}" EX 30
GET cache:partido:P-01:resumen
TTL cache:partido:P-01:resumen
# Cambio en la fuente de verdad: se invalida la copia y la proxima lectura la reconstruye.
DEL cache:partido:P-01:resumen
GET cache:partido:P-01:resumen
SET cache:partido:P-01:resumen "{\"partido\":\"P-01\",\"local\":\"ARG\",\"visitante\":\"BRA\",\"estado\":\"FINALIZADO\",\"goles_local\":1,\"goles_visitante\":0,\"revision_fuente\":2}" EX 30
GET cache:partido:P-01:resumen
# Si Redis no esta disponible, la aplicacion sigue desde la fuente de verdad:
# Redis es una aceleracion, nunca la autoridad del dato.
DEL cache:partido:P-01:resumen
