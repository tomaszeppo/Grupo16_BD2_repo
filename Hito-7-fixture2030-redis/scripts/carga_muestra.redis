# carga_muestra.redis
# Datos de ejemplo: sesiones, cache de equipos, contador de visitas y ranking con
# el caso de empate ya armado (ver docs/ciclo_de_vida_e_invalidacion.md).
# Se puede correr todas las veces que haga falta: empieza borrando sus propias claves
# (lista finita, nunca KEYS), porque INCRBY y ZINCRBY suman sobre lo que ya hay y
# sin el DEL inicial una segunda corrida duplicaria los puntos.

# --- Limpieza previa ---
DEL sesion:sess-000001
DEL usuario:user-00001:sesion_activa
DEL sesion:sess-000002
DEL usuario:user-00002:sesion_activa
DEL sesion:sess-000003
DEL usuario:user-00003:sesion_activa
DEL sesion:sess-000004
DEL usuario:user-00004:sesion_activa
DEL sesion:sess-000005
DEL usuario:user-00005:sesion_activa
DEL sesion:sess-000006
DEL usuario:user-00006:sesion_activa
DEL sesion:sess-000007
DEL usuario:user-00007:sesion_activa
DEL sesion:sess-000008
DEL usuario:user-00008:sesion_activa
DEL sesion:sess-000009
DEL usuario:user-00009:sesion_activa
DEL sesion:sess-000010
DEL usuario:user-00010:sesion_activa
DEL cache:equipo:ARG
DEL cache:equipo:BRA
DEL cache:equipo:ESP
DEL cache:equipo:FRA
DEL cache:equipo:GER
DEL cache:equipo:JPN
DEL contador:partido:P-01:visitas
DEL ranking:publico

# --- Sesiones de muestra (10 usuarios con sesion activa, 30 minutos) ---
HSET sesion:sess-000001 usuario_id user-00001 creado_en 2030-07-20T20:01:00 ultima_actividad 2030-07-20T20:01:00 estado activa
EXPIRE sesion:sess-000001 1800
SET usuario:user-00001:sesion_activa sess-000001 EX 1800
HSET sesion:sess-000002 usuario_id user-00002 creado_en 2030-07-20T20:02:00 ultima_actividad 2030-07-20T20:02:00 estado activa
EXPIRE sesion:sess-000002 1800
SET usuario:user-00002:sesion_activa sess-000002 EX 1800
HSET sesion:sess-000003 usuario_id user-00003 creado_en 2030-07-20T20:03:00 ultima_actividad 2030-07-20T20:03:00 estado activa
EXPIRE sesion:sess-000003 1800
SET usuario:user-00003:sesion_activa sess-000003 EX 1800
HSET sesion:sess-000004 usuario_id user-00004 creado_en 2030-07-20T20:04:00 ultima_actividad 2030-07-20T20:04:00 estado activa
EXPIRE sesion:sess-000004 1800
SET usuario:user-00004:sesion_activa sess-000004 EX 1800
HSET sesion:sess-000005 usuario_id user-00005 creado_en 2030-07-20T20:05:00 ultima_actividad 2030-07-20T20:05:00 estado activa
EXPIRE sesion:sess-000005 1800
SET usuario:user-00005:sesion_activa sess-000005 EX 1800
HSET sesion:sess-000006 usuario_id user-00006 creado_en 2030-07-20T20:06:00 ultima_actividad 2030-07-20T20:06:00 estado activa
EXPIRE sesion:sess-000006 1800
SET usuario:user-00006:sesion_activa sess-000006 EX 1800
HSET sesion:sess-000007 usuario_id user-00007 creado_en 2030-07-20T20:07:00 ultima_actividad 2030-07-20T20:07:00 estado activa
EXPIRE sesion:sess-000007 1800
SET usuario:user-00007:sesion_activa sess-000007 EX 1800
HSET sesion:sess-000008 usuario_id user-00008 creado_en 2030-07-20T20:08:00 ultima_actividad 2030-07-20T20:08:00 estado activa
EXPIRE sesion:sess-000008 1800
SET usuario:user-00008:sesion_activa sess-000008 EX 1800
HSET sesion:sess-000009 usuario_id user-00009 creado_en 2030-07-20T20:09:00 ultima_actividad 2030-07-20T20:09:00 estado activa
EXPIRE sesion:sess-000009 1800
SET usuario:user-00009:sesion_activa sess-000009 EX 1800
HSET sesion:sess-000010 usuario_id user-00010 creado_en 2030-07-20T20:10:00 ultima_actividad 2030-07-20T20:10:00 estado activa
EXPIRE sesion:sess-000010 1800
SET usuario:user-00010:sesion_activa sess-000010 EX 1800

# --- Cache de catalogo (equipos mas consultados, 5 minutos) ---
SET cache:equipo:ARG "{\"codigo\":\"ARG\",\"confederacion\":\"CONMEBOL\",\"ranking\":1}" EX 300
SET cache:equipo:BRA "{\"codigo\":\"BRA\",\"confederacion\":\"CONMEBOL\",\"ranking\":4}" EX 300
SET cache:equipo:ESP "{\"codigo\":\"ESP\",\"confederacion\":\"UEFA\",\"ranking\":9}" EX 300
SET cache:equipo:FRA "{\"codigo\":\"FRA\",\"confederacion\":\"UEFA\",\"ranking\":12}" EX 300
SET cache:equipo:GER "{\"codigo\":\"GER\",\"confederacion\":\"UEFA\",\"ranking\":13}" EX 300
SET cache:equipo:JPN "{\"codigo\":\"JPN\",\"confederacion\":\"AFC\",\"ranking\":33}" EX 300

# --- Contador de visitas del partido P-01 (1 hora) ---
SET contador:partido:P-01:visitas 0 EX 3600

# --- Ranking publico: caso de empate ---
# Score = puntos + antelacion_total / 10.000.000. ZINCRBY suma al score del miembro
# de forma atomica (si el miembro no existe, lo crea). La parte entera son los puntos;
# la decimal, siempre menor a 1, es la antelacion y desempata.
# Orden esperado: 1) user-00003 (300 puntos, 8800 de antelacion)
#                 2) user-00001 (300, 5000)   3) user-00002 (300, 1200)
#                 4) user-00006 (280)   5) user-00004 (250, pese a tener la mayor antelacion)
#                 6) user-00005 (210) ... y el resto por puntaje descendente
ZINCRBY ranking:publico 300.0005000 user-00001
ZINCRBY ranking:publico 300.0001200 user-00002
ZINCRBY ranking:publico 300.0008800 user-00003
ZINCRBY ranking:publico 250.0009000 user-00004
ZINCRBY ranking:publico 210.0003000 user-00005
ZINCRBY ranking:publico 280.0004000 user-00006
ZINCRBY ranking:publico 142.0001735 user-00007
ZINCRBY ranking:publico 161.0005832 user-00008
ZINCRBY ranking:publico 72.0001093 user-00009
ZINCRBY ranking:publico 197.0001271 user-00010
ZINCRBY ranking:publico 153.0005274 user-00011
ZINCRBY ranking:publico 74.0004656 user-00012
ZINCRBY ranking:publico 114.0000807 user-00013
ZINCRBY ranking:publico 82.0004052 user-00014
ZINCRBY ranking:publico 167.0001072 user-00015

# Verificar el resultado:
ZREVRANGE ranking:publico 0 -1 WITHSCORES
