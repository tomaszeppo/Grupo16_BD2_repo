# concurrencia.redis
# Operaciones concurrentes del modulo (RF8). Dos casos, de menor a mayor complejidad.
# La prueba con varios procesos en paralelo esta en prueba_concurrencia.py.

# --- Caso simple: contador de visitas con INCRBY ---
# INCRBY es atomico: Redis lo ejecuta de una sola vez, sin importar cuantos clientes
# lo manden a la vez. Hacer GET, sumar en la aplicacion y despues SET, en cambio,
# pierde actualizaciones cuando dos clientes leen el mismo valor antes de escribir.
DEL contador:partido:P-01:visitas
SET contador:partido:P-01:visitas 0 EX 3600
INCRBY contador:partido:P-01:visitas 1
INCRBY contador:partido:P-01:visitas 1
INCRBY contador:partido:P-01:visitas 5
GET contador:partido:P-01:visitas
TTL contador:partido:P-01:visitas

# --- Dos cambios que tienen que verse juntos: MULTI/EXEC ---
# Se suma a las visitas y se anota cuando fue la ultima. Redis ejecuta el bloque sin
# intercalar otros comandos. El EXPIRE va dentro del bloque para que la clave de
# metadatos tambien venza.
MULTI
INCRBY contador:partido:P-01:visitas 10
HSET contador:partido:P-01:meta ultima_operacion incremento-demo
EXPIRE contador:partido:P-01:meta 3600
EXEC
GET contador:partido:P-01:visitas
HGETALL contador:partido:P-01:meta

# --- Caso del ranking: sumar puntos y antelacion al score de un usuario ---
# ZINCRBY suma el delta al score de forma atomica. El delta combina los dos criterios:
# puntos + antelacion / 10.000.000. El usuario suma 3 puntos y 10 minutos de antelacion.
ZSCORE ranking:publico user-00001
ZINCRBY ranking:publico 3.000001 user-00001
ZSCORE ranking:publico user-00001
ZREVRANGE ranking:publico 0 4 WITHSCORES
